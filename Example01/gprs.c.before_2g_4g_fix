char *mv2endof_str(char* src, char* match, int len)
{

	char *s, *m;

	s = src;
	m = match;
	int found = 0;

	while(*s && len){
		if(*s == *m){
			s++;
			m++;
			if(*m == 0){
				found = 1;
				break;
			}
		}
		else{
			s++;
			m = match;
		}
		len--;
	}

	if (!found)
		s = -1;
	return (s);
}




