	// serverset is not used presently

	//	char SIMXFERRES[]=">";
	char temp_rec[96];
	char http_data[300];
	char http_response[300];
	int i, lf_recd, timeout, dest_in_count,http_xfer_result;
	char *matching_ptr;
	char msg_response[50];

	char *gprs_months[12] = {"Jan", "Feb", "Mar", "Apr",
			"May", "Jun", "Jul", "Aug",
			"Sep", "Oct", "Nov", "Dec" };
	char gprs_new_mon[4], gprs_new_day[5];
	int gprs_month_no;


	sprintf(gprs_xmit_buf,"AT+CIPOPEN=0,\"TCP\",\"%s\",%d\r\n",Global_Data_Params.gc_http_server_name1, Global_Data_Params.gi_http_server_port1);
	response_no =  Send_And_Check_Gprs(gprs_xmit_buf, "+CIPOPEN: 0,0", "ERROR", 15000);
	vTaskDelay(10 / portTICK_RATE_MS);

	sprintf(gprs_xmit_buf,"AT+CIPSEND=0,\r\n");

	gprs_xmit_ptr = gprs_xmit_buf;
	UART_SendData((LPC_UART_TypeDef*) GPRS_UART, *gprs_xmit_ptr++);
	vTaskDelay(5 / portTICK_RATE_MS);	// wait a while for transmission to take place

	dest_in_count = 0;
	msg_response[0] = 0;
	timeout = 15000/10;
	while(( (lf_recd = getline((char *)0x2007c000, msg_response, &gprs_recv_in_cnt, &gprs_recv_out_cnt,
			&dest_in_count, RECVBUF_SIZE, (int) *(SIMXFERRES))) != 1) &&(timeout)) {
		vTaskDelay(10 / portTICK_RATE_MS);
		timeout--;
	}
	vTaskDelay(2 / portTICK_RATE_MS);
	vTaskDelay(2 / portTICK_RATE_MS);

	//	strcpy(temp_rec, "stn_id=00001920&rec_time=2020-12-11,14:05&rainfall=0&signal=-085&key=sit1040&bat_volt=14.32");

	/*
	 * Http headers
	 * Line 1:	POST link HTTP/1.1\r\n
	 * Line 2:	Host: server\r\n
	 * Line 3:	Content-Type: application/x-www-form-urlencoded\r\n
	 * Line 4:	Content-Length: len\r\n
	 * Line 5:	\r\n
	 * Line 6:	http data from log task
	 *
	 */
	//strcpy(http_data, "POST /weather_info/data_upload/trg_data HTTP/1.1\r\n");
	sprintf(http_data, "POST %s HTTP/1.1\r\n", Global_Data_Params.gc_http_link1);
	//strcat(http_data, "Host: www.spatika.net\r\n");
	sprintf(http_data, "%sHost: %s\r\n",http_data,Global_Data_Params.gc_http_server_name1);
	strcat(http_data, "Content-Type: application/x-www-form-urlencoded\r\n");
	sprintf(http_data, "%sContent-Length: %d\r\n\r\n", http_data, strlen(gc_http_data));

	strcat(http_data, gc_http_data);

	strcat(http_data, "\032");	// CTRL+Z

	// send the data and wait for the response
	for(i=0; i<sizeof(http_response); i++)
		http_response[i]=0;
	gprs_xmit_ptr = http_data;
	UART_SendData((LPC_UART_TypeDef*) GPRS_UART, *gprs_xmit_ptr++);
	vTaskDelay(10 / portTICK_RATE_MS);	// wait a while for transmission to take place
	dest_in_count = 0;
	vTaskDelay(2 / portTICK_RATE_MS);
	http_xfer_result = eXfer_In_Progress;

	http_response[dest_in_count]=0;
	//sim900 30000/2
	for(timeout=3000; (timeout>0) && (http_xfer_result == eXfer_In_Progress); timeout--){
		//	for(timeout=3000; (timeout>0) && (http_xfer_result == eXfer_In_Progress); timeout--){

		while(( (lf_recd = getline((char *)0x2007c000, http_response, &gprs_recv_in_cnt, &gprs_recv_out_cnt,
				&dest_in_count, RECVBUF_SIZE, LINE_FEED)) != 1) &&(timeout)) {
			vTaskDelay(10 / portTICK_RATE_MS); //sizeof(gprs_recv_buf)
			timeout--;
		}


		if(lf_recd){
			lf_recd = 0;
			if((matching_ptr = look_for_str(http_response, "Date:")) != 0 ){
				//Date: Wed, 18 Jul 2012 05:52:39 GMT
				sscanf(matching_ptr, "Date: %[^,], %d %s %d %d:%d", &gprs_new_day,
						&gprs_new_date, &gprs_new_mon, &gprs_new_year, &gprs_new_hour, &gprs_new_minute);
				for(gprs_month_no = 0; gprs_month_no < 12; gprs_month_no++)
					if(strcmp(gprs_months[gprs_month_no], gprs_new_mon) == 0)
						break;
				if (gprs_month_no < 12){
					gprs_new_month = gprs_month_no+1;
					gprs_new_minute += 30;
					if(gprs_new_minute >= 60){
						gprs_new_minute %= 60;
						gprs_new_hour += 6;
					}
					else
						gprs_new_hour += 5;
					if(gprs_new_hour >= 24){
						gprs_new_hour %= 24;
						Next_Date(&gprs_new_date, &gprs_new_month, &gprs_new_year);
					}

					gprs_server_date_Ok = 1;
				}
			}
			if((matching_ptr = look_for_str(http_response, "Success")) != 0 ){
				http_xfer_result = eXfer_Success;
				http_status  = 1;
				gi_http_error = 0;
				//printf("Http Success\r\n");
			}
			else if ((matching_ptr = look_for_str(http_response, "Rejected")) != 0 ){
				http_xfer_result = eXfer_Rejected;
				gi_http_error = 1;
				//printf("Http Rejected\r\n");
			}
			else if ((matching_ptr = look_for_str(http_response, "Invalid")) != 0 ){
				http_xfer_result = eXfer_Fail;
				gi_http_error = 1;
				//printf("Http Invalid\r\n");
			}

			else
				vTaskDelay(10 / portTICK_RATE_MS);
		}
	}

	// if the response is OK, return
	if (timeout)
		return(http_xfer_result);
	else{
		//printf("Http Timeout");
		gprs_timeout_occurred = 1;
		return(eXfer_Tmo);
		gi_http_error = 1;
	}
}




int send_message(char *gsm_no, char *msg_text)
{
	int lf_recd, dest_in_count, timeout, msg_end;
	char send_msg_cmd[32], msg_response[256], msg_str[256], *in_ptr, *out_ptr;


	in_ptr = msg_text;

	msg_end = 0;

	response_no=Send_And_Check_Gprs("\r\nAT&F\r\n", "OK", "ERROR", 3000);
	vTaskDelay(500 / portTICK_RATE_MS);

	// first give send sms command
	response_no	=  Send_And_Check_Gprs("\r\nAT+CMGF=1\r\n", "OK", "ERROR", 5000);
	vTaskDelay(1000 / portTICK_RATE_MS);
	gi_dota_error = 0;
	//	strcpy(gsm_no, "9741391102");
	sprintf(send_msg_cmd, "AT+CMGS=\"%s\"\r", gsm_no);
	gprs_xmit_ptr = send_msg_cmd;
	UART_SendData((LPC_UART_TypeDef*) GPRS_UART, *gprs_xmit_ptr++);
	vTaskDelay(20 / portTICK_RATE_MS);	// wait a while for transmission to take place
	if(gi_dota_error)
		return(eNack);
	dest_in_count = 0;
	msg_response[0] = 0;
	timeout = 50000/10;
	while(( (lf_recd = getline((char *)0x2007c000, msg_response, &gprs_recv_in_cnt, &gprs_recv_out_cnt,
			&dest_in_count, RECVBUF_SIZE, '>')) != 1) &&(timeout)) {
		vTaskDelay(10 / portTICK_RATE_MS);
		timeout--;
	}

	if(!timeout)
		return(eNack);

	while(!msg_end){
		out_ptr = msg_str;
		while((*in_ptr != '\n') && (*in_ptr != 0) && (*in_ptr != '\032'))
			*out_ptr++ = *in_ptr++;

		if ((*in_ptr == 0) || (*in_ptr == '\032'))
			msg_end = 1;
		else
			*out_ptr++ = *in_ptr++;

		*out_ptr = 0;

		// now let us send the message and wait for '>' everyline

		if(msg_str[0] != 0){
			gprs_xmit_ptr = msg_str;
			UART_SendData((LPC_UART_TypeDef*) GPRS_UART, *gprs_xmit_ptr++);
			vTaskDelay(20 / portTICK_RATE_MS);	// wait a while for transmission to take place
			dest_in_count = 0;
			msg_response[0] = 0;

			//timeout = 30000/10;
			//timeout = 300/10;        // for sim800
			timeout = 50;

			gi_dota_error = 0;
			//printf("%s", msg_str);
			while(( (lf_recd = getline((char *)0x2007c000, msg_response, &gprs_recv_in_cnt, &gprs_recv_out_cnt,
					&dest_in_count, RECVBUF_SIZE, '>')) != 1) &&(timeout)) {
				vTaskDelay(10 / portTICK_RATE_MS);
				timeout--;
				if(gi_dota_error)
					return(eNack);

			}
		}
	}
	vTaskDelay(100 / portTICK_RATE_MS);
	response_no = Send_And_Check_Gprs("\032", "OK", "ERROR", 5000);
	vTaskDelay(300 / portTICK_RATE_MS);

	return(response_no);
}



