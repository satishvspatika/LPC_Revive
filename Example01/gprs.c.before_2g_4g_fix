					if((matching_ptr = look_for_str(msg_data, "MEASURED_WS2")) != 0)
						sscanf(matching_ptr,"MEASURED_WS2=%f", &ws_measued2);

					ws_calib_factor    = ((ws_actual2-ws_actual1) / (ws_measued2 - ws_measued1));
