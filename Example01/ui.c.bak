/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Edit
 * 	DESCRIPTION : This function is used to edit the cursor for key press(UP,DOWN,LEFT,RIGHT)
* 	VERSION : 1.5
* 	ARGUMENTS : key
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :ui_lcd_disp_buf, iLcd_Cur_Posn
*	CALLED FUNCTION : Ui_Edit_Rightkey, Ui_Edit_Leftkey, Ui_Edit_Upkey, Ui_Edit_Downkey
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Edit(int key)
{
	int i, posn;

	posn = iLcd_Cur_Posn & 0x3f;

	switch (key) {
	case eUp_Key:
		ui_lcd_disp_buf[posn] = (ui_lcd_disp_buf[posn] + 1 - '0') % 10 + '0';
		break;
	case eDown_Key:
		ui_lcd_disp_buf[posn] = (ui_lcd_disp_buf[posn] + 9 - '0') % 10 + '0';
		break;
	case eRight_Key:
		for (i = 0; i < 16; i++) {
			posn = (posn + 1) % 16;
			if ((ui_lcd_disp_buf[posn] > 0x2F)
					&& (ui_lcd_disp_buf[posn] < 0x3A))
				break;

		}
		iLcd_Cur_Posn = (iLcd_Cur_Posn & 0xc0) | posn;
		break;
	case eLeft_Key:
		for (i = 0; i < 16; i++) {
			posn = (posn + 15) % 16;
			if ((ui_lcd_disp_buf[posn] > 0x2F)
					&& (ui_lcd_disp_buf[posn] < 0x3A))
				break;
		}
		iLcd_Cur_Posn = (iLcd_Cur_Posn & 0xc0) | posn;

		break;
	default:
		break;
	}

}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Set_RTC
 * 	DESCRIPTION : This function is used to set the new date time to RTC.
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : XITC_Ui_Rtc.px_New_Date_Time, ui_lcd_disp_buf, xUi_Date_Time.date, xUi_Date_Time.month, xUi_Date_Time.year
*						xUi_Date_Time.hour, xUi_Date_Time.minute
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Set_RTC(void)
{
	int date, month, year, hour, minute;
	sscanf(ui_lcd_disp_buf, "%d-%d-%d,%d:%d", &date, &month, &year, &hour, &minute);
	xUi_Date_Time.date		= date;
	xUi_Date_Time.month		= month;
	xUi_Date_Time.year		= year;
	xUi_Date_Time.hour		= hour;
	xUi_Date_Time.minute	= minute;
	XITC_Ui_Rtc.px_New_Date_Time = &xUi_Date_Time;
	XITC_Ui_Rtc.signal = 1;
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Clear_Display
 * 	DESCRIPTION : This function is used to clear the LCD display.
* 	VERSION : 1.5
* 	ARGUMENTS : NOne
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :XITC_Ui_Lcd.disp_str
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Clear_Display(void)
{
	strcpy (ui_lcd_disp_buf2, "                ");
	while (XITC_Ui_Lcd.sig)
		vTaskDelay(10 / portTICK_RATE_MS);
	XITC_Ui_Lcd.lcd_posn	= 0x80;
	XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
	sprintf(XITC_Ui_Lcd.disp_str, "%s", ui_lcd_disp_buf2);
	XITC_Ui_Lcd.sig = 1;
	while (XITC_Ui_Lcd.sig)
		vTaskDelay(10 / portTICK_RATE_MS);
	XITC_Ui_Lcd.lcd_posn	= 0xC0;
	XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
	sprintf(XITC_Ui_Lcd.disp_str, "%s", ui_lcd_disp_buf2);
	XITC_Ui_Lcd.sig = 1;
	while (XITC_Ui_Lcd.sig)
		vTaskDelay(10 / portTICK_RATE_MS);

}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Disp_n_Get
 * 	DESCRIPTION : This function is used to get the scrolling message in LCD.
* 	VERSION : 1.5
* 	ARGUMENTS : posn,  scroll_buf
* 	RETURN VALUES : iKey
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :XITC_Ui_Lcd.disp_str, ui_lcd_disp_buf
*	CALLED FUNCTION : Ui_Calib
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

int Ui_Disp_n_Get(int posn, char scroll_buf[])
{
	int iKey,  i;
	iKey = eNo_Key;
	// show the second row
	XITC_Ui_Lcd.lcd_posn	= 0xC0;
	XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
	sprintf(XITC_Ui_Lcd.disp_str, "%s", ui_lcd_disp_buf2);
	XITC_Ui_Lcd.sig = 1;
	while (XITC_Ui_Lcd.sig)
		vTaskDelay(10 / portTICK_RATE_MS);

	// show the first row in scroll mode
	strcpy (ui_lcd_disp_buf, "                ");
	for(i=0; i<16; i++){
		if(scroll_buf[posn+i])
			ui_lcd_disp_buf[i] = scroll_buf[posn+i];
		else {
			ui_lcd_disp_buf[i] = 0;
			break;
		}
	}
	ui_lcd_disp_buf[i] = 0;
	XITC_Ui_Lcd.lcd_posn	= 0x80;
	XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
	sprintf(XITC_Ui_Lcd.disp_str, "%s", ui_lcd_disp_buf);
	XITC_Ui_Lcd.sig = 1;
	while (XITC_Ui_Lcd.sig)
		vTaskDelay(10 / portTICK_RATE_MS);

	// now see if any key is pressed
	if(XITC_Kbd_Log.sig_key == 1){
		XITC_Kbd_Log.sig_key = 0;
		if((XITC_Kbd_Log.key_value == eSet_Key) || (XITC_Kbd_Log.key_value == eBack_Key))
			iKey = XITC_Kbd_Log.key_value;
	}
	return(iKey);
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Calib
 * 	DESCRIPTION : This function will be called when we press the calib key. This calibration state is mainly used for checking the rainfall sensors
 * 				and it will give Calibration status and Calibration date. we are measuring 0.5mm rain. While doing calibration we can get either
 * 				success or failed. We should give 10tips then in LCD it will show 5mm , then press enter it will give success. It should be 5 mm.
 * 				it will give failed status if rainfall is not 5mm
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : gi_rf_before_calib, XITC_Ui_F968UART.calib_rf,
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : Ui_Disp_n_Get
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Calib(void)
{
	int Ui_Calib_State, iKey;
	char Ui_Scrolling_Lcd_Buf[100];
	Ui_Calib_State = eCalib_Idle;
	Ui_Clear_Display();
	int loop_active;
	int iPosition;

	iPosition = 0;
	loop_active = 1;

	while(loop_active){
		vTaskDelay(400 / portTICK_RATE_MS);
		switch(Ui_Calib_State){
		case eCalib_Idle:
			strcpy(Ui_Scrolling_Lcd_Buf,   "               Perform Calibration Checks? (Press Set/Back)                 ");
			if(iPosition > strlen(Ui_Scrolling_Lcd_Buf))
				iPosition = 0;
			iKey = Ui_Disp_n_Get(iPosition, Ui_Scrolling_Lcd_Buf);
			if(iKey == eSet_Key){
				Ui_Calib_State = eCalib_Rain;	// first perform Rain Calibration
				gi_rf_before_calib = rainfall;
				XITC_Ui_Disk.command = eITC_Ui_Disk_Save_Params;
				vTaskDelay(100 / portTICK_RATE_MS);
				XITC_Ui_F968UART.signal = 1;
				XITC_Ui_F968UART.command = eReset_Rf_Ui;
				while(XITC_Ui_F968UART.signal)
					vTaskDelay(100 / portTICK_RATE_MS);

				XITC_Ui_F968UART.calib_on = 1;
				XITC_Ui_F968UART.calib_rf = 0;
				iKey = eNo_Key;
				iPosition  = 0;
			}
			else if (iKey == eBack_Key){
				loop_active = 0;
				iKey = eNo_Key;
			}
			else
				iKey = eNo_Key;
			iPosition = (iPosition+1)%(strlen(Ui_Scrolling_Lcd_Buf));
			if(strlen(Ui_Scrolling_Lcd_Buf)>16){
				if((strlen(Ui_Scrolling_Lcd_Buf)-iPosition)==16)
						iPosition = 0;
			}
			break;

		case eCalib_Rain:
			strcpy(Ui_Scrolling_Lcd_Buf,   "               Checking Rainfall Calibration                 ");
			sprintf(ui_lcd_disp_buf2, " Rain  =  %03d.%01d ", XITC_Ui_F968UART.calib_rf/2, ((XITC_Ui_F968UART.calib_rf%2)?5:0));
			if(iPosition > strlen(Ui_Scrolling_Lcd_Buf))
				iPosition = 0;

			iKey = Ui_Disp_n_Get(iPosition, Ui_Scrolling_Lcd_Buf);
			if(iKey == eSet_Key){
				Cailb_Status_Details.date = xPresent_Date_Time.date;
				Cailb_Status_Details.month = xPresent_Date_Time.month;
				Cailb_Status_Details.year = xPresent_Date_Time.year;

				if (XITC_Ui_F968UART.calib_rf == 10){
					strcpy(Ui_Scrolling_Lcd_Buf,   "Calib  Success !  ");
					Cailb_Status_Details.status = 1;
				}
				else{
					strcpy(Ui_Scrolling_Lcd_Buf,   "Calib  Failed     ");
					Cailb_Status_Details.status = 0;
				}
				XITC_Ui_Disk.command = eITC_Ui_Disk_Save_Params;
				Ui_Calib_State = eCalib_Idle;	// first perform Rain Calibration
				XITC_Ui_F968UART.calib_on = 0;
				XITC_Ui_F968UART.signal = 1;
				XITC_Ui_F968UART.command = eReset_Rf_Ui;
				while(XITC_Ui_F968UART.signal)
					vTaskDelay(10 / portTICK_RATE_MS);

				XITC_Ui_F968UART.signal = 1;
				XITC_Ui_F968UART.command = eAdd_Rf_Calib;
				while(XITC_Ui_F968UART.signal)
					vTaskDelay(100 / portTICK_RATE_MS);

				// show the status
				XITC_Ui_Lcd.lcd_posn	= 0x80;
				XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
				sprintf(XITC_Ui_Lcd.disp_str, "%s", Ui_Scrolling_Lcd_Buf);
				XITC_Ui_Lcd.sig = 1;
				while (XITC_Ui_Lcd.sig)
					vTaskDelay(10 / portTICK_RATE_MS);


				vTaskDelay(5000 / portTICK_RATE_MS);
				// record all the new params
				// now quit
				iKey = eNo_Key;
				loop_active = 0;
			}
			else if (iKey == eBack_Key){
				XITC_Ui_F968UART.calib_on = 0;
				XITC_Ui_F968UART.signal = 1;
				XITC_Ui_F968UART.command = eReset_Rf_Ui;
				while(XITC_Ui_F968UART.signal)
					vTaskDelay(100 / portTICK_RATE_MS);

				XITC_Ui_F968UART.signal = 1;
				XITC_Ui_F968UART.command = eAdd_Rf_Calib;
				while(XITC_Ui_F968UART.signal)
					vTaskDelay(100 / portTICK_RATE_MS);

				iKey = eNo_Key;
				loop_active = 0;
			}
			else
				iKey = eNo_Key;
			iPosition = (iPosition+1)%(strlen(Ui_Scrolling_Lcd_Buf));
			if(strlen(Ui_Scrolling_Lcd_Buf)>16){
				if((strlen(Ui_Scrolling_Lcd_Buf)-iPosition)==16)
						iPosition = 0;
			}

			break;

		default:
			break;

		}
	}
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : vUi_Task
 * 	DESCRIPTION : This function is used to run the Task for ever
 * 					•	This task is designed for giving user interface. UI Task will be interacting between LCD Task and KBD Task.
					•	UI Task is having following states :
						1.	Welcome Screen ( it will display product details)
						2.	Date time screen (we can edit the date time by using Key board).
						3.	Rain fall details ( it will give present rainfall)
						4.	Closed Rainfall ( it will give Closed(8.30) data rain fall of the date)
						5.	Copy to USB (it will ask the from date to copy the data to USB).
						6.	Params Display( it will give Station Id, Station name, Signal Level, SIM Status, Last Logged date, Network Error details, Calibration details,
						Battery voltage, version,).
						7.	Send status message to Universal GSM Number.
						8.	Load new parameters by USB.
						9.	Load new firmware by USB.
*
* 	VERSION : 1.5
* 	ARGUMENTS : pvParameters
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iUi_State, iUi_Step, iUi_State, XITC_Ui_Lcd.disp_str
*	CALLED FUNCTION : main
*	CALLING FUNCTION : xUi_Steps
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void vUi_Task(void *pvParameters)
{
	int i;

	XITC_Ui_Lcd.sig = 0;
	XITC_Ui_Rtc.signal = 0;
	while(!kbd_task_started){
		vTaskDelay(100 / portTICK_RATE_MS);
	}

	XITC_Ui_Disk.command = eITC_Ui_Disk_Nop;

	iUi_State = eUi_Idle;	// make it display
	iUi_Step = 0;
	iUi_Timer_End = 1;

	gUi_Active = 0;		// Assume UI is not active
	deg_symbol = 0xdf; // degree symbol
	per_symbol = 0x25; // % symbol
	vTaskDelay(100 / portTICK_RATE_MS);
	for(;;){

		if(XITC_Kbd_Log.sig_key == 1){
			iNew_Key_2b_Processed = XITC_Kbd_Log.key_value;
		}


		if ( ((iUi_Timer_End) || (iNew_Key_2b_Processed)) && (XITC_Ui_Lcd.sig == 0)) {
			iUi_Timer_End = 0;
			iUi_Step_Entry_No = 0;

			// Let us get the correct step entry number now

			if(iUi_State > eUi_Idle){
				for (i = 0; i < iUi_State; i++)
					iUi_Step_Entry_No += iUi_No_Of_Steps[i];
			}
			iUi_Step_Entry_No += iUi_Step; // now we have got the step
			if(iUi_State == eUi_Welcome)
				i = 0;
			iUi_Key_for_match = xUi_Steps[iUi_Step_Entry_No].ikey;

			if ((iUi_Key_for_match == WILD_KEY) || (iUi_Key_for_match == iNew_Key_2b_Processed)) {

				ptr2function = xUi_Steps[iUi_Step_Entry_No].ptr2function;
				ptr2function();

				while (XITC_Ui_Lcd.sig);
				// setup the lcd queue and send the same
				XITC_Ui_Lcd.lcd_posn	= xUi_Steps[iUi_Step_Entry_No].uclcd_addr;
				XITC_Ui_Lcd.lcd_cmd		= xUi_Steps[iUi_Step_Entry_No].uclcd_cmd;
				sprintf(XITC_Ui_Lcd.disp_str, "%s", xUi_Steps[iUi_Step_Entry_No].ptr2_lcd_display_str);
				XITC_Ui_Lcd.sig = 1;


/*				if (xUi_Steps[iUi_Step_Entry_No].uclcd_cmd == eLcd_Cur_On) {
					iLcd_Cur_Posn = xUi_Steps[iUi_Step_Entry_No].uclcd_addr;

				}
*/
				if (xUi_Steps[iUi_Step_Entry_No].uclcd_cmd == eLcd_Set_Addr) {
					XITC_Ui_Lcd.lcd_posn = iLcd_Cur_Posn;
				}


				if (iUi_Key_for_match == iNew_Key_2b_Processed){
					iNew_Key_2b_Processed = 0;
					XITC_Kbd_Log.sig_key = 0;
				}
				iUi_State = xUi_Steps[iUi_Step_Entry_No].iNext_State;
				iUi_Step = xUi_Steps[iUi_Step_Entry_No].iNext_Step;

				if (iUi_State == UI_RET) {
					iUi_State = iUi_Ret_State;
					iUi_Step = iUi_Ret_Step;
				}

				if (xUi_Steps[iUi_Step_Entry_No].iTc > 0) {
					iUi_Timer_Tc = xUi_Steps[iUi_Step_Entry_No].iTc;
				}
			}
			else {
				iUi_Step++;
				iUi_Step %= iUi_No_Of_Steps[iUi_State];
				iUi_Timer_Tc = 1;
			}
		}

		// scheduler last

		if (iUi_Timer_Tc) {
			iUi_Timer_Tc--;
			if (iUi_Timer_Tc == 0)
				iUi_Timer_End = 1;
		}

	/*	taskENTER_CRITICAL();
		gi_wdt_task_ok_stat |= WDT_UI_OK;
		taskEXIT_CRITICAL();
*/
		vTaskDelay(10 / portTICK_RATE_MS);

	}
}

