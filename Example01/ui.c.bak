		KEY_TIMEOUT,&Ui_Nop,		eLcd_Off,		0,		"",					eUi_Idle,	      0, 1,	   //11


		/* 13 copy firmware1*/
		WILD_KEY,	&Ui_Nop,        eLcd_Display,	0x80,	"   Copy Firmware  ",eUi_Copy_Firmware1,1, 1,		//0
		WILD_KEY,	&Ui_Nop,		eLcd_Display,	0xC0,	"    For LPC824?   ",eUi_Copy_Firmware1,2, 100,	//1
		eMenu_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Copy_Firmware1,0, 1,		//2
		eUp_Key,	&Ui_Nop,	    eLcd_Display,	0,		"",					eUi_Copy_Firmware1,4, 1,		//3
		eCalib_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Copy_Firmware1,5, 1,		//4
		eLeft_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Copy_Firmware1,6, 1, 	//5
		eSet_Key,	&Ui_Copy_Firmware1,eLcd_Display,	0xC0,	ui_lcd_disp_buf,	eUi_Welcome,	  0, 300,	//6
		eRight_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Copy_Firmware1,8, 1, 	//7
		eBack_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Copy_Firmware,  0, 1, 	//8
		eDown_Key,	&Ui_Nop,	    eLcd_Display,	0,		"",					eUi_Copy_Firmware1,10,1, 	//9
		eDisp_Key,	&Ui_Nop,		eLcd_Display,	0,		"",					eUi_Idle, 		  0, 1,	   //10
		KEY_TIMEOUT,&Ui_Nop,		eLcd_Off,		0,		"",					eUi_Idle,	      0, 1,	   //11


};



