/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Next_Date
 * 	DESCRIPTION : This function is used to call the following two functions:
				Next_Date : it is used to find the next date of the given date
				Ui_Get_Rf: it is used to get the Closed Rainfall of the day

* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :ui_date, ui_month, ui_year, ui_lcd_disp_buf
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : Ui_Get_Rf
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Next_Date(void) {
	Next_Date(&ui_date, &ui_month, &ui_year);
	sprintf(ui_lcd_disp_buf, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);
	Ui_Get_Rf();
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Prev_Date
 * 	DESCRIPTION : This function is used to call the following two functions:
					Prev_Date : it is used to find the Previous date of the given date
					Ui_Get_Rf: it is used to get the Closed Rainfall of the day.
 *
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :ui_date, ui_month, ui_year, ui_lcd_disp_buf
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : Ui_Get_Rf
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Prev_Date(void) {
	Previous_Date(&ui_date, &ui_month, &ui_year);
	sprintf(ui_lcd_disp_buf, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);
	Ui_Get_Rf();
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Next_Date
 * 	DESCRIPTION : This function is used to find the next date of the given date.
* 	VERSION : 1.5
* 	ARGUMENTS : Nd, Nm, Ny
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :None
*	CALLED FUNCTION : Ui_Usb_Copy, Ui_Next_Date
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Next_Date(int *Nd, int *Nm, int *Ny)
{
	int no_of_days[14] = { 29, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };

	int prev_mm;

	*Nd = *Nd + 1;

	if ((*(Ny) % 4 == 0) && (*Nm == 2)) {
		prev_mm = 0;
	} else {
		prev_mm = *Nm;
	}
	if (*Nd > no_of_days[prev_mm]) {
		*Nd = 1;
		*Nm = *Nm + 1;
		if (*Nm > 12) {
			*Nm = 1;
			*Ny = *Ny + 1;
		}
	}

}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Previous_Date
 * 	DESCRIPTION : This function is used to find the previous date of the given date.
* 	VERSION : 1.5
* 	ARGUMENTS : Cd, Cm, Cy
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :None
*	CALLED FUNCTION : Ui_Prev_Date
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Previous_Date(int *Cd, int *Cm, int *Cy) {
	int no_of_days[14] = { 29, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
	int prev_mm_day;
	int prev_dd_day;
	prev_mm_day = *Cm;
	prev_dd_day = *Cd - 1;
	if (0 == prev_dd_day) {
		prev_mm_day = prev_mm_day - 1;
		if (prev_mm_day == 0) {
			prev_mm_day = 12;
			*Cy = *Cy - 1;
		}

		if ((*(Cy + 0) % 4 == 0) && (prev_mm_day == 2)) {
			prev_dd_day = 29;
		} else {
			prev_dd_day = no_of_days[prev_mm_day];
		}
	}

	*Cd = prev_dd_day;
	*Cm = prev_mm_day;

}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Prep_Date_Edit
 * 	DESCRIPTION : This function is used to edit the date while copy to usb
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :iLcd_Cur_Posn, iUi_Ret_State, iUi_Ret_Step
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Prep_Date_Edit(void)
{
	int posn;

	if (iUi_State == eUi_History) {
		sprintf(ui_lcd_disp_buf, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);
	}
	if(iUi_State == eUi_USB_Copy){
		sprintf(ui_lcd_disp_buf, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);
	}
	for (posn = 0; posn < 16; posn++) {
		if ((ui_lcd_disp_buf[posn] > 0x2F) && (ui_lcd_disp_buf[posn] < 0x3A))
			break;
	}
	if(iUi_State == eUi_Date_Time){
		iLcd_Cur_Posn = posn+0xC0;
		iUi_Ret_State = eUi_Date_Time;
	}
	else if(iUi_State == eUi_History){
		iLcd_Cur_Posn = posn+0x80;
		iUi_Ret_State = eUi_History;
	}
	else if(iUi_State == eUi_USB_Copy){
		iLcd_Cur_Posn = posn+0x80;
		iUi_Ret_State = eUi_USB_Copy;
	}


	iUi_Ret_Step = 0;
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Last_Mon
 * 	DESCRIPTION : This function is used to find the last month date for copying one month data.
 * 				( for example today date is 25-06-2014 then when you press the enter key for copying from date will show 01-05-2014).
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :ui_date, ui_month, ui_year, ui_lcd_disp_buf, iLcd_Cur_Posn
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Last_Mon(void){

	int posn;
	// last month ?
	ui_date = 1;
	ui_month	= xPresent_Date_Time.month - 1;
	if (ui_month == 0){
		ui_year		= xPresent_Date_Time.year - 1;
		ui_month = 12;
	}
	else
		ui_year		= xPresent_Date_Time.year;

	sprintf(ui_lcd_disp_buf, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);

	for (posn = 0; posn < 16; posn++) {
		if ((ui_lcd_disp_buf[posn] > 0x2F) && (ui_lcd_disp_buf[posn] < 0x3A))
			break;
	}
	iLcd_Cur_Posn = posn+0xC0;
}


