}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Usb_Copy
 * 	DESCRIPTION : This function will be called when we set the date for copying data to USB. We can set From date only.
 * 				 ( for example when we set the 10-06-2014 then it will copy the data up to today.
 * 				  So from date only we have to set here and To date it will take as Today date automatically).
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : ui_lcd_disp_buf, XITC_Ui_Disk.date, XITC_Ui_Disk.month, XITC_Ui_Disk.year, XITC_Ui_Lcd.disp_str
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : Next_Date
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Usb_Copy(void){
	int date, month, year, hour, minute;
	int time_out, copying_over;
	time_out = 3000;
	sscanf(ui_lcd_disp_buf, "%d-%d-%d", &date, &month, &year);
	ui_date		= date;
	ui_month	= month;
	ui_year		= year;
	copying_over = 0;
	for(;;){
		XITC_Ui_Disk.date = ui_date;
		XITC_Ui_Disk.month = ui_month;
		XITC_Ui_Disk.year = ui_year;
		XITC_Ui_Disk.command = eITC_Ui_Disk_Copy;

		sprintf(XITC_Ui_Lcd.disp_str, "   %02d-%02d-%04d    ", ui_date, ui_month, ui_year);
		XITC_Ui_Lcd.lcd_posn	= 0x80;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;

		while(XITC_Ui_Lcd.sig)
			vTaskDelay(10 / portTICK_RATE_MS);

		sprintf(XITC_Ui_Lcd.disp_str, "Copying...       ");
		XITC_Ui_Lcd.lcd_posn	= 0xC0;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;

		while(XITC_Ui_Lcd.sig)
			vTaskDelay(10 / portTICK_RATE_MS);

		while (XITC_Ui_Disk.command ){
			vTaskDelay(10 / portTICK_RATE_MS);
			time_out--;		// what will happen if there is a timeout.... to be discussed
		}

		if (XITC_Ui_Disk.result == -1)
			sprintf(XITC_Ui_Lcd.disp_str, "Copying  Failed ");

		else
			sprintf(XITC_Ui_Lcd.disp_str, "Copying  OK     ");

		XITC_Ui_Lcd.lcd_posn	= 0xC0;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;
		taskENTER_CRITICAL();
		gi_wdt_task_ok_stat |= WDT_UI_OK;
		taskEXIT_CRITICAL();
		vTaskDelay(400 / portTICK_RATE_MS);


		if ((ui_date == xPresent_Date_Time.date) && (ui_month == xPresent_Date_Time.month)
				&& (ui_year == xPresent_Date_Time.year) ){
			copying_over = 1;
		}

		if (copying_over ==1) break;

		Next_Date(&ui_date, &ui_month, &ui_year);

	}

	if(copying_over == 1){
		sprintf(XITC_Ui_Lcd.disp_str, "Copying  DONE     ");
		XITC_Ui_Lcd.lcd_posn	= 0xC0;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;
		vTaskDelay(3000 / portTICK_RATE_MS);

		sprintf(XITC_Ui_Lcd.disp_str, "  Power OFF and   ");
		XITC_Ui_Lcd.lcd_posn	= 0x80;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;
		while (XITC_Ui_Lcd.sig);
		sprintf(XITC_Ui_Lcd.disp_str, " Remove the USB ");
		XITC_Ui_Lcd.lcd_posn	= 0xC0;
		XITC_Ui_Lcd.lcd_cmd		= eLcd_Display;
		XITC_Ui_Lcd.sig = 1;

		vTaskDelay(5000 / portTICK_RATE_MS);
	}

}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Next_Param
 * 	DESCRIPTION : It will give next state of the parameters and this function will be called when we press the UP Key in Params Screen
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iUi_Param_No, iUi_timeout
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Next_Param(void)
{

	iUi_Param_No = (iUi_Param_No+1) % MAX_UI_PARAMS;
	iUi_timeout = 0;
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Prev_Param
 * 	DESCRIPTION : It will give Previous state of the parameters and this function will be called when we press the DOWN Key in Params Screen.
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iUi_Param_No, iUi_timeout
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Prev_Param(void)
{
	iUi_Param_No = (iUi_Param_No+(MAX_UI_PARAMS-1)) % MAX_UI_PARAMS;
	iUi_timeout = 0;
}
