/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : show_rf
 * 	DESCRIPTION : This function is used to display the Closed RF
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : ui_lcd_disp_buf
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void show_rf(void)
{
	if (ui_rain != -1)
		sprintf(ui_lcd_disp_buf, "Closed RF  %03d.%1d ", ui_rain/2, ((ui_rain%2)?5:0));
	else {
		sprintf(ui_lcd_disp_buf, "Closed RF    NIL  ");
	}
}
/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Get_Rf
 * 	DESCRIPTION : This function is used to get closed rainfall of the date.
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : XITC_Ui_Disk.date, XITC_Ui_Disk.month, XITC_Ui_Disk.year, XITC_Ui_Disk.hour, XITC_Ui_Disk.minute, ui_rain
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Get_Rf(void)
{
	char *ptr_read_buf;
	float frain;
	// get the rf value from SD card !!
	XITC_Ui_Disk.date	= ui_date;
	XITC_Ui_Disk.month	= ui_month;
	XITC_Ui_Disk.year	= ui_year;
	XITC_Ui_Disk.hour	= CLOSING_HR;
	XITC_Ui_Disk.minute	= CLOSING_MIN;
	XITC_Ui_Disk.command = eITC_Ui_Disk_Get;
	while(XITC_Ui_Disk.command)
		vTaskDelay(40 / portTICK_RATE_MS);
	ptr_read_buf = look_for_str(XITC_Ui_Disk.read_buf, "rainfall=");
	if((ptr_read_buf ) != 0){
		sscanf(ptr_read_buf, "rainfall=%f", &frain);
		ui_rain = (int)(frain*2);
	}
	else
		ui_rain = -1;

}

