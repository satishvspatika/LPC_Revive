/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Clr1
 * 	DESCRIPTION : This function is used to disable the Display key from key processing
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iNew_Key_2b_Processed, gUi_Active
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Clr1(void)
{
	if (iNew_Key_2b_Processed != eDisp_Key){
		iNew_Key_2b_Processed = 0;
		XITC_Kbd_Log.sig_key = 0;
	}
	gUi_Active = 0;		// no more UI
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Clr2
 * 	DESCRIPTION : This function is used to disable the display key and menu key from key processing.
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iNew_Key_2b_Processed, XITC_Kbd_Log.sig_key
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Clr2(void)
{
	if ((iNew_Key_2b_Processed != eDisp_Key) &&
			(iNew_Key_2b_Processed != eMenu_Key)){
		iNew_Key_2b_Processed = 0;
		XITC_Kbd_Log.sig_key = 0;
	}
}

/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Clr3
 * 	DESCRIPTION : This function is used to disable the Enter key, display key, menu key and back key from key processing
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : iNew_Key_2b_Processed, XITC_Kbd_Log.sig_key
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Clr3(void)
{
	if ((iNew_Key_2b_Processed != eSet_Key) && (iNew_Key_2b_Processed != eDisp_Key) &&
			(iNew_Key_2b_Processed != eMenu_Key)&&(iNew_Key_2b_Processed != eBack_Key)){
		iNew_Key_2b_Processed = 0;
		XITC_Kbd_Log.sig_key = 0;
	}
}

