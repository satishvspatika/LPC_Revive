/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Get_Param
 * 	DESCRIPTION : This function is used to get the Signal Strength and SIM States
* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED :iUi_timeout
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Get_Param(void)
{
	if(iUi_timeout)
		iUi_timeout--;
	else if (XITC_Ui_Gprs.signal != 1){
		if (iUi_Param_No == 1){
			XITC_Ui_Gprs.command = eUi_Gprs_Get_Sglvl;
			XITC_Ui_Gprs.result	= 0;
			XITC_Ui_Gprs.signal = 1;
			iUi_timeout = 20000/120;
		}
		else if(iUi_Param_No == 2){
			XITC_Ui_Gprs.command = eUi_Gprs_Get_CPIN;
			XITC_Ui_Gprs.result	= 0;
			XITC_Ui_Gprs.signal = 1;
			iUi_timeout = 20000/120;
		}
	}
}


