/* New prog to look at the pwd seq */
void Ui_Pwd_Set(void)
{
	if((iUi_Pwd == 1) || (iUi_Pwd == 2) )
		iUi_Pwd++;
	else
		iUi_Pwd = 0;


}
void Ui_Pwd_Cal(void)
{
	if((iUi_Pwd == 0) || (iUi_Pwd == 3) || (iUi_Pwd == 4) )
		iUi_Pwd++;
	else
		iUi_Pwd = 0;
	if (iUi_Pwd == 5)
		iUi_Param_No = 9;

}
/*-------------------------------------------------------------------------------------------------------------------------------------------*
* 	FUNCTION NAME : Ui_Show_Param
 * 	DESCRIPTION : This function is used to display all the states of the parameters. Totally 10 states are there
					1.	Welcome Screen ( it will display product details)
					2.	Date time screen (we can edit the date time by using Key board).
					3.	Rain fall details ( it will give present rainfall)
					4.	Closed Rainfall ( it will give Closed(8.30) data rain fall of the date)
					5.	Copy to USB (it will ask the from date to copy the data to USB).
					6.	Params Display( it will give Station Id, Station name, Signal Level, SIM Status, Last Logged date, Network Error details, Calibration details,
						Battery voltage, version,).
					7.	Send status message to Universal GSM Number.
					8.	Load new parameters by USB.
					9.	Load new firmware by USB.
					10.	Test the Battery Charging and Cutoff

* 	VERSION : 1.5
* 	ARGUMENTS : None
* 	RETURN VALUES : None
* 	GLOBALS INPUT : None
*	GLOBALS AFFECTED : ui_lcd_disp_buf,
*	CALLED FUNCTION : xUi_Steps
*	CALLING FUNCTION : None
*

/*----------------------------------------------------------------------------------------------------------------------------------------------*/

void Ui_Show_Param(void)
{

	strcpy(ui_lcd_disp_buf,  "                 ");
	strcpy(ui_lcd_disp_buf2, ui_lcd_disp_buf);

	switch(iUi_Param_No){

	case 0:	// station params
		sprintf(ui_lcd_disp_buf,  "Stn ID:   %s    ", Global_Data_Params.gc_station_id);
		sprintf(ui_lcd_disp_buf2, " %s            ", Global_Data_Params.gc_station_name);
		break;

	case 1: // signal level
		sprintf(ui_lcd_disp_buf,  " Signal   Level ");
		sprintf(ui_lcd_disp_buf2, "    %d dBm   ", gi_signal_level);
		break;

	case 2: // sim status
		sprintf(ui_lcd_disp_buf,  "   SIM Status   ");
		if (gi_sim_state == 0)
			sprintf(ui_lcd_disp_buf2, "     ERROR      ");
		else
			sprintf(ui_lcd_disp_buf2, "       OK       ");
		break;

	case 3: // Net State
		sprintf(ui_lcd_disp_buf,  " Last Logged at ");
		sprintf(ui_lcd_disp_buf2, "%02d-%02d-%04d %02d:%02d",
				gi_log_date, gi_log_month, gi_log_year,
				gi_log_hour, (gi_log_minute));
		break;

	case 4:  // error details
		sprintf(ui_lcd_disp_buf,  "   Net Error    ");
		sprintf(ui_lcd_disp_buf2, " P=%d    C=%d   ", gi_present_error, gi_net_error);
		break;

	case 5:  // Calib status
		sprintf(ui_lcd_disp_buf,  "Calib: %s        ", (Cailb_Status_Details.status?"Success   ":"Failed    "));
		sprintf(ui_lcd_disp_buf2, " on %02d-%02d-%04d  ",  Cailb_Status_Details.date,Cailb_Status_Details.month,Cailb_Status_Details.year);
		break;


	case 6:
		sprintf(ui_lcd_disp_buf,  " Battery Voltage ");
		sprintf(ui_lcd_disp_buf2, "      %.2f        ", bat_volt);
		break;

	case 7:
		sprintf(ui_lcd_disp_buf,  "    Version     ");
		sprintf(ui_lcd_disp_buf2, "%s-%s           ", Global_Data_Params.gc_version, lpc845_ver);
		break;

	default:
		break;

	}
	while(strlen(ui_lcd_disp_buf2) < 17)
		strcat(ui_lcd_disp_buf2, " ");


}
